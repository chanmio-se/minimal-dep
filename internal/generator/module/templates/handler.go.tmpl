// Package handler handles {{.Name}} HTTP requests.
package handler

import (
	"errors"
	"log/slog"
	"net/http"
	"strings"

	"minimal-dep/internal/modules/{{.Name}}/domain"
	"minimal-dep/internal/modules/{{.Name}}/usecase"
	"minimal-dep/internal/platform/http/htmx"
	"minimal-dep/internal/platform/http/middleware"
	"minimal-dep/internal/platform/http/respond"
	"minimal-dep/internal/platform/templates"
)

// Handler exposes {{.Name}} endpoints.
type Handler struct {
	usecase  *usecase.Usecase
	renderer *templates.Renderer
	logger   *slog.Logger
}

// New builds a handler.
func New(uc *usecase.Usecase, renderer *templates.Renderer, logger *slog.Logger) *Handler {
	return &Handler{usecase: uc, renderer: renderer, logger: logger}
}

type view struct {
	Items     []domain.Item
	CSRFToken string
}

// Index renders the page, or the list fragment for HTMX requests.
func (h *Handler) Index(w http.ResponseWriter, r *http.Request) {
	owner, ok := middleware.PrincipalFrom(r.Context())
	if !ok {
		http.Redirect(w, r, "/login", http.StatusSeeOther)
		return
	}
	items, err := h.usecase.List(r.Context(), owner.ID)
	if err != nil {
		respond.Error(w, r, h.logger, http.StatusInternalServerError, "could not load items", err)
		return
	}
	h.render(w, r, view{Items: items, CSRFToken: middleware.CSRFTokenFor(r)})
}

// Create adds an item after form and CSRF validation.
func (h *Handler) Create(w http.ResponseWriter, r *http.Request) {
	owner, ok := h.principal(w, r)
	if !ok {
		return
	}
	if err := r.ParseForm(); err != nil {
		h.formError(w, r, err)
		return
	}
	name := strings.TrimSpace(r.PostFormValue("name"))
	if !validName(name) {
		respond.Error(w, r, h.logger, http.StatusBadRequest, "name must be 1-200 characters", nil)
		return
	}
	if _, err := h.usecase.Create(r.Context(), owner.ID, name); err != nil {
		h.usecaseError(w, r, err)
		return
	}
	h.afterMutation(w, r)
}

// Rename changes an item. Authorization is enforced by the usecase.
func (h *Handler) Rename(w http.ResponseWriter, r *http.Request) {
	owner, ok := h.principal(w, r)
	if !ok {
		return
	}
	if err := r.ParseForm(); err != nil {
		h.formError(w, r, err)
		return
	}
	name := strings.TrimSpace(r.PostFormValue("name"))
	if !validName(name) {
		respond.Error(w, r, h.logger, http.StatusBadRequest, "name must be 1-200 characters", nil)
		return
	}
	if err := h.usecase.Rename(r.Context(), owner.ID, r.PathValue("id"), name); err != nil {
		h.usecaseError(w, r, err)
		return
	}
	h.afterMutation(w, r)
}

func (h *Handler) principal(w http.ResponseWriter, r *http.Request) (middleware.Principal, bool) {
	owner, ok := middleware.PrincipalFrom(r.Context())
	if !ok {
		http.Error(w, "unauthorized", http.StatusUnauthorized)
	}
	return owner, ok
}

func (h *Handler) formError(w http.ResponseWriter, r *http.Request, err error) {
	status := http.StatusBadRequest
	if middleware.IsBodyTooLarge(err) {
		status = http.StatusRequestEntityTooLarge
	}
	respond.Error(w, r, h.logger, status, "invalid form", err)
}

func (h *Handler) afterMutation(w http.ResponseWriter, r *http.Request) {
	if !htmx.IsHTMXRequest(r) {
		http.Redirect(w, r, "/{{.Name}}", http.StatusSeeOther)
		return
	}
	h.Index(w, r)
}

func (h *Handler) render(w http.ResponseWriter, r *http.Request, data view) {
	if err := htmx.Render(w, r, h.renderer, "app/layout", "{{.Name}}/list", data); err != nil {
		respond.Error(w, r, h.logger, http.StatusInternalServerError, "render failed", err)
	}
}

func (h *Handler) usecaseError(w http.ResponseWriter, r *http.Request, err error) {
	status, message := http.StatusInternalServerError, "could not update items"
	switch {
	case errors.Is(err, usecase.ErrInvalidInput):
		status, message = http.StatusBadRequest, err.Error()
	case errors.Is(err, usecase.ErrForbidden):
		status, message = http.StatusForbidden, "item belongs to another owner"
	case errors.Is(err, usecase.ErrNotFound):
		status, message = http.StatusNotFound, "item not found"
	}
	respond.Error(w, r, h.logger, status, message, err)
}

func validName(name string) bool { return name != "" && len(name) <= 200 }
