// Package domain owns the {{.Name}} business rules.
package domain

import (
	"errors"
	"fmt"
	"strings"
)

// ErrInvalidInput is returned when input violates a business rule.
var ErrInvalidInput = errors.New("invalid input")

// Item is an owned entity of the {{.Name}} module.
type Item struct {
	ID      string
	OwnerID string
	Name    string
}

// NewItem creates a validated item.
func NewItem(id, ownerID, name string) (Item, error) {
	id = strings.TrimSpace(id)
	ownerID = strings.TrimSpace(ownerID)
	name = strings.TrimSpace(name)
	switch {
	case id == "":
		return Item{}, fmt.Errorf("%w: id is required", ErrInvalidInput)
	case ownerID == "":
		return Item{}, fmt.Errorf("%w: owner is required", ErrInvalidInput)
	case name == "" || len(name) > 200:
		return Item{}, fmt.Errorf("%w: name must be 1-200 characters", ErrInvalidInput)
	}
	return Item{ID: id, OwnerID: ownerID, Name: name}, nil
}
