// Package repository persists {{.Name}} data.
package repository

import (
	"context"
	"errors"

	"minimal-dep/internal/modules/{{.Name}}/domain"
)

// ErrNotFound is returned when an item does not exist.
var ErrNotFound = errors.New("{{.Name}} item not found")

// Repository is the persistence contract used by the usecase layer.
type Repository interface {
	Create(ctx context.Context, item domain.Item) error
	ListByOwner(ctx context.Context, ownerID string) ([]domain.Item, error)
	FindByID(ctx context.Context, id string) (domain.Item, error)
	Save(ctx context.Context, item domain.Item) error
}
